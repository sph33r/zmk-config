#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------
            // | TDESC|  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |  BKSP |
            // | TAB  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |   '   |
            // | LCTRL|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |RETSHFT|
            //                    | GUI | LWR | SHFT|   | SPC | RSE  |LALT |

            bindings = <
&kp ESC   &kp Q &kp W &kp E &kp R &kp T        &kp Y &kp U &kp I     &kp O   &kp P    &kp BSPC
&kp TAB   &kp A &kp S &kp D &kp F &kp G        &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z &kp X &kp C &kp V &kp B        &kp N &kp M &kp COMMA &kp DOT &kp FSLH &mt RSHFT RET
              &kp LGUI  &mo 1  &kp LSHFT    &kp SPC  &mo 2  &kp LALT
            >;
        };

        lower_layer {
            // ---------------------------------------------------------------------------------
            // |   `  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |   DEL  |
            // |      |     |     |     |  _  |  -  |   | "|" |  [  |  ]  |     |     |        |
            // |      |     |     |     |  =  |  +  |   |  \  |  {  |  }  |     |     |        |
            //                    |     |     |     |   |     | ADJ |     |

            bindings = <
&kp GRAVE &kp EXCL &kp AT &kp HASH &kp DLLR  &kp PRCNT      &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp DEL
&trans    &none    &none  &none    &kp UNDER &kp MINUS      &kp PIPE  &kp LBKT &kp RBKT &none    &none    &none
&trans    &none    &none  &none    &kp EQUAL &kp PLUS       &kp BSLH  &kp LBRC &kp RBRC &none    &none    &trans
                          &trans    &trans     &trans       &trans     &mo 3     &trans
            >;
        };

        raise_layer {
            // --------------------------------------------------------------------------------
            // |  ~  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |        |
            // |     |     |     |     | HOME| END |   | LFT | DOWN| UP  |RIGHT|     |        |
            // |     |     |     |     |     | PRSC|   | PGUP| PGDN|     |     |     |        |
            //                   |     | ADJ |     |   |     |     |     |

            bindings = <
&kp TILDE &kp N1 &kp N2 &kp N3 &kp N4    &kp N5        &kp N6    &kp N7    &kp N8 &kp N9    &kp N0 &kp DELETE
&trans    &none  &none  &none  &kp HOME  &kp END       &kp LEFT  &kp DOWN  &kp UP &kp RIGHT &trans &trans
&trans    &none  &none  &none  &kp INS   &kp PSCRN     &kp PG_UP &kp PG_DN &trans &trans    &trans &trans
                     &trans  &mo 3       &trans           &trans     &trans     &trans
            >;
        };

        adjust_layer {
            // --------------------------------------------------------------------------------
            // |      |     |     |     |     |     |   |     |     |     |     |     |       |
            // |      |     |     |     |     |     |   |BTCLR|BTNXT|BTPRV|     |     | RESET |
            // |BTCLRA|     |     |VOLUP|VOLDN|MUTE |   | BT0 | BT1 | BT2 | BT3 | BT4 |       |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&none          &none &none &none         &none        &none        &none        &none        &none        &none        &none        &none
&none          &none &none &none         &none        &none        &bt BT_CLR   &bt BT_NXT   &bt BT_PRV   &none        &none        &sys_reset
&bt BT_CLR_ALL &none &none &kp KC_VOL_UP &kp C_VOL_DN &kp C_MUTE   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none
                     &trans  &trans  &trans          &trans        &trans        &trans
            >;
        };
    };
};

